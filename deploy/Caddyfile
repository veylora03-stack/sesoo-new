{$SITE_DOMAIN} {
    encode gzip zstd

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Static files (pre-collected by entrypoint, served via WhiteNoise)
    handle /static/* {
        uri strip_prefix /static
        root * /srv/static
        file_server {
            expires 30d
        }
    }

    # Media files (uploaded via admin, stored in media_data volume)
    handle /media/* {
        uri strip_prefix /media
        root * /srv/media
        file_server {
            expires 30d
        }
    }

    # Reverse proxy to Django/Gunicorn
    handle {
        reverse_proxy web:8000
    }
}
